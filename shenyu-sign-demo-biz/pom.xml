<?xml version="1.0" encoding="UTF-8"?>
<!--
  ~ 拆分后的 BIZ（业务系统）工程。
  ~ 仅持有 biz-private-key（加签出站请求）+ pay-public-key（验签响应/回调）。
  ~ 不注册到网关（它是调用方 + 回调接收方，不是网关上游）。
  -->
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>2.7.18</version>
        <relativePath/>
    </parent>

    <groupId>org.apache.shenyu</groupId>
    <artifactId>shenyu-sign-demo-biz</artifactId>
    <version>2.7.0.1-jdk8-SNAPSHOT</version>
    <packaging>jar</packaging>
    <name>shenyu-sign-demo-biz</name>

    <properties>
        <java.version>1.8</java.version>
        <maven.compiler.source>1.8</maven.compiler.source>
        <maven.compiler.target>1.8</maven.compiler.target>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    </properties>

    <dependencies>
        <!-- BIZ 不依赖任何 shenyu jar：签名工具已内置在 org.apache.shenyu.demo.sign.biz.security 包 -->
        <!-- OkHttp：BIZ 出站请求（加签 + 调用支付/网关） -->
        <dependency>
            <groupId>com.squareup.okhttp3</groupId>
            <artifactId>okhttp</artifactId>
            <version>4.9.3</version>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>
        </plugins>
    </build>
</project>
