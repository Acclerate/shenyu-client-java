<?xml version="1.0" encoding="UTF-8"?>
<!--
  ~ 网关侧 RSA 验签 SPI 工程。
  ~ 实现 ShenYu 2.6.1 的 SignService 接口，用业务系统公钥验签入站请求的 X-Pay-Sign。
  ~ 打成 jar 放到 shenyu-bootstrap/ext-lib/，通过 JVM 启动 classpath 加载，
  ~ Spring 启动期扫描到 @Bean SignService，触发 @ConditionalOnMissingBean 替换默认 ComposableSignService。
  -->
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>org.apache.shenyu</groupId>
    <artifactId>shenyu-sign-gateway-spi</artifactId>
    <version>2.6.1</version>
    <packaging>jar</packaging>
    <name>shenyu-sign-gateway-spi</name>

    <properties>
        <java.version>1.8</java.version>
        <maven.compiler.source>1.8</maven.compiler.source>
        <maven.compiler.target>1.8</maven.compiler.target>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <shenyu.version>2.6.1</shenyu.version>
        <spring.version>5.3.31</spring.version>
        <!-- ShenYu 2.6.1 基于 Spring Boot 2.x；用于 actuator HealthIndicator -->
        <spring-boot.version>2.7.18</spring-boot.version>
    </properties>

    <dependencies>
        <!-- ShenYu sign 插件 API（provided，由 bootstrap 容器提供） -->
        <dependency>
            <groupId>org.apache.shenyu</groupId>
            <artifactId>shenyu-plugin-sign</artifactId>
            <version>${shenyu.version}</version>
            <scope>provided</scope>
        </dependency>
        <!-- ShenYu plugin-base（provided，由 bootstrap 容器提供）：BaseDataCache -->
        <dependency>
            <groupId>org.apache.shenyu</groupId>
            <artifactId>shenyu-plugin-base</artifactId>
            <version>${shenyu.version}</version>
            <scope>provided</scope>
        </dependency>
        <!-- ShenYu sign starter（provided）：仅编译期引用 SignPluginConfiguration 做 @AutoConfigureBefore，
             确保 PayRsaSignService 先于官方 ComposableSignService 注册，消除双 Bean（铁律 7） -->
        <dependency>
            <groupId>org.apache.shenyu</groupId>
            <artifactId>shenyu-spring-boot-starter-plugin-sign</artifactId>
            <version>${shenyu.version}</version>
            <scope>provided</scope>
        </dependency>
        <!-- Spring WebFlux（provided，由 bootstrap 容器提供） -->
        <dependency>
            <groupId>org.springframework</groupId>
            <artifactId>spring-webflux</artifactId>
            <version>${spring.version}</version>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>org.springframework</groupId>
            <artifactId>spring-context</artifactId>
            <version>${spring.version}</version>
            <scope>provided</scope>
        </dependency>
        <!-- Spring Boot Actuator（provided）：用于 AppAuthHealthIndicator，bootstrap 镜像已含 -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-actuator</artifactId>
            <version>${spring-boot.version}</version>
            <scope>provided</scope>
        </dependency>
        <!-- gson：解析 admin 下发的 JSON（镜像 lib/ 已含 gson-2.9.0，避免引入 Jackson 与 WebFlux 冲突） -->
        <dependency>
            <groupId>com.google.code.gson</groupId>
            <artifactId>gson</artifactId>
            <version>2.9.0</version>
            <scope>provided</scope>
        </dependency>

        <!-- 测试：JUnit 5 -->
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <version>5.9.2</version>
            <scope>test</scope>
        </dependency>
        <!-- 测试：Mockito（4.11.0 支持 JDK 8），用于单测 mock -->
        <dependency>
            <groupId>org.mockito</groupId>
            <artifactId>mockito-core</artifactId>
            <version>4.11.0</version>
            <scope>test</scope>
        </dependency>
        <!-- 测试：spring-test 提供 MockServerWebExchange / MockServerHttpRequest（网关验签集成测试） -->
        <dependency>
            <groupId>org.springframework</groupId>
            <artifactId>spring-test</artifactId>
            <version>${spring.version}</version>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <!-- SPI 主 jar -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-jar-plugin</artifactId>
                <version>3.3.0</version>
            </plugin>
            <!-- 单元测试（JUnit 5） -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <version>3.1.2</version>
            </plugin>
        </plugins>
    </build>
</project>
