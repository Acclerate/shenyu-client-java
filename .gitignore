# maven ignore
target/
*.class
*.jar
*.war
*.zip
*.tar
*.tar.gz
.flattened-pom.xml
dependency-reduced-pom.xml

# maven plugin ignore
release.properties
cobertura.ser
*.gpg

# eclipse ignore
.settings/
.project
.classpath

# idea ignore
.idea/
.workbuddy/
.zcode/
!/.idea/icon.svg
!/.idea/vcs.xml
*.ipr
*.iml
*.iws

# temp ignore
logs/
*.log
*.doc
*.cache
*.diff
*.patch
*.tmp

# system ignore
.DS_Store
Thumbs.db

# agent build ignore
/agent/

# rust ignore
*.lock
*/*/target/
*/*/target/*

nacos-probe/*
deptree*

# 联调测试私钥（禁止提交，避免泄露）
/docs/_joint_test_keys/
*.pem
