<!--
  Minimal Spring Boot demo to verify shenyu-client-java (springmvc) HTTP registration
  to a local ShenYu admin (2.7.0.3) running in Docker.
-->
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>org.apache.shenyu.demo</groupId>
    <artifactId>shenyu-http-demo</artifactId>
    <version>1.0.0</version>
    <packaging>jar</packaging>
    <name>shenyu-http-demo</name>

    <!-- Spring Boot 2.7.x parent (matches shenyu-client-java 2.7.0.1-jdk8: spring-boot 2.7.18) -->
    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>2.7.18</version>
        <relativePath/>
    </parent>

    <properties>
        <java.version>1.8</java.version>
        <maven.compiler.source>1.8</maven.compiler.source>
        <maven.compiler.target>1.8</maven.compiler.target>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <!-- matches the locally installed client artifact version -->
        <shenyu.version>2.7.0.1-jdk8-SNAPSHOT</shenyu.version>
    </properties>

    <dependencies>
        <!-- ShenYu springmvc client starter: brings auto-config + @ShenyuSpringMvcClient + http register -->
        <dependency>
            <groupId>org.apache.shenyu</groupId>
            <artifactId>shenyu-spring-boot-starter-client-springmvc</artifactId>
            <version>${shenyu.version}</version>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>
        </plugins>
    </build>
</project>
