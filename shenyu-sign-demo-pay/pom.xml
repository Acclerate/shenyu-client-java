<?xml version="1.0" encoding="UTF-8"?>
<!--
  ~ 拆分后的 PAY（支付服务）工程。
  ~ 仅持有 pay-private-key（加签响应/回调）+ biz-public-key（验签入站请求）。
  ~ 注册到 ShenYu 网关作为上游服务（@ShenyuSpringMvcClient）。
  -->
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>2.7.18</version>
        <relativePath/>
    </parent>

    <groupId>org.apache.shenyu</groupId>
    <artifactId>shenyu-sign-demo-pay</artifactId>
    <version>2.7.0.1-jdk8-SNAPSHOT</version>
    <packaging>jar</packaging>
    <name>shenyu-sign-demo-pay</name>

    <properties>
        <java.version>1.8</java.version>
        <maven.compiler.source>1.8</maven.compiler.source>
        <maven.compiler.target>1.8</maven.compiler.target>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    </properties>

    <dependencies>
        <!-- 注册到 ShenYu 网关（参考 shenyu-http-demo） -->
        <dependency>
            <groupId>org.apache.shenyu</groupId>
            <artifactId>shenyu-spring-boot-starter-client-springmvc</artifactId>
            <version>${project.version}</version>
        </dependency>
        <!-- 复用 shenyu-client-core 的签名工具 -->
        <dependency>
            <groupId>org.apache.shenyu</groupId>
            <artifactId>shenyu-client-core</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>
        </plugins>
    </build>
</project>
